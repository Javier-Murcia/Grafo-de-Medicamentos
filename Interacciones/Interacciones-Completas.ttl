<http://www.medicamentos.es/Interacción/C07BB07+C08DB01>
        rdf:type                      med:Interacción;
        rdfs:label                    "C07BB07+C08DB01";
        med:efectoInteraccion         "Aumento del riesgo de toxicidad por litio."@es , "Aumento del riesgo de bradicardia intensa i descompensación de la insuficiencia cardíaca."@es , "Aumento del riesgo de depresión miocárdica."@es , "Aumento del riesgo de hipertensión de rebote cuando se suspende la clonidina, empeorada por la presencia de un beta bloqueante."@es;
        med:interaccionaCon           atc:C08DB01;
        med:recomendacionInteraccion  "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. "@es , "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. Se recomienda monitorizar los niveles de litio."@es , "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. En caso necesario, monitorizar estrechamente al paciente."@es , "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. En caso necesario, utilizar sólo si está preservada la función miocardíaca y monitorizar el ECG."@es , "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. Interrumpir el tratamiento con el beta bloqueante algunos días antes de iniciar la suspensión gradual de la clonidina."@es;
        med:seRefiereATC              atc:C07BB07;
        med:tienePrincipioActivo      prinactiv:1768 , prinactiv:6720 , prinactiv:10721 .

