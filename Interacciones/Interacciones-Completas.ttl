<http://www.medicamentos.es/Interacción/J01FA01+R06AX28>
        rdf:type                      med:Interacción;
        rdfs:label                    "J01FA01+R06AX28";
        med:efectoInteraccion         "Riesgo de potenciación de los efectos adversos de la carbamazepina (cefaleas, vértigo)."@es , "Riesgo de aparición de efectos adversos de dapoxetina."@es , "Prolongación del intervalo QT."@es , "Aumento del riesgo de bradicardia grave."@es , "Aumento de los efectos adversos de triazolam"@es , "Aumento de las concentraciones plasmáticas de rupatadina."@es , "Aumento de las concentraciones de teofilina."@es , "Aumento del riesgo de arritmias ventriculares."@es , "Aumento del riesgo de miopatía y rabdomiolisis."@es , "Aumento del riesgo de toxicidad de colchicina."@es , "Aumento de las concentraciones del inmunosupresor."@es , "Aumento del riesgo de vasoconstricción coronaria y/o crisis hipertensivas."@es , "Aumento de las concentraciones plasmáticas de quetiapina."@es , "Aumento de las concentraciones de dronedarona."@es;
        med:interaccionaCon           atc:R06AX28;
        med:recomendacionInteraccion  "Asociación contraindicada. Se recomienda suspender uno de los principios activos."@es , "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. "@es , "Asociación desaconsejada. Si es posible, suspender uno de los principios activos. Si no fuese posible, monitorizar el intervalo QT."@es , "Asociación desaconsejada. Valorar el beneficio/riesgo del tratamiento. Se recomienda utilizar rupatidina con precaución."@es;
        med:seRefiereATC              atc:J01FA01;
        med:tienePrincipioActivo      prinactiv:1952 , prinactiv:1954 .

